{
  "name": "@thisismissem/adonisjs-atproto-labeler",
  "description": "Adonis.js provider for building an AT Protocol Labeler",
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "main": "build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./commands": "./build/commands/main.js",
    "./provider": "./build/providers/provider.js",
    "./service": "./build/services/labeler.js",
    "./store": "./build/src/lucid_label_store.js",
    "./types": "./build/src/types.js",
    "./atproto_labeler_middleware": "./build/src/middleware.js"
  },
  "scripts": {
    "changeset": "changeset",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run typecheck && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "pretest": "pnpm run lint",
    "test": "c8 pnpm run quick:test",
    "types:check": "attw --pack . --profile esm-only --profile node16 --ignore-rules=cjs-resolves-to-esm",
    "precompile": "pnpm run lint",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "postcompile": "pnpm run copy:templates && pnpm run index:commands",
    "index:commands": "adonis-kit index build/commands",
    "build": "pnpm run compile",
    "version-packages": "changeset version && pnpm run format:write CHANGELOG.md && git add package.json CHANGELOG.md",
    "release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "atproto",
    "at protocol",
    "labeler"
  ],
  "author": "Emelia Smith",
  "license": "MIT",
  "contributors": [
    {
      "name": "Emelia Smith",
      "url": "https://github.com/thisismissem"
    }
  ],
  "repository": {
    "url": "https://github.com/ThisIsMissEm/adonisjs-atproto-labeler"
  },
  "dependencies": {
    "@atcute/atproto": "^3.1.10",
    "@atcute/crypto": "^2.4.1",
    "@atcute/labeler": "^0.1.0",
    "@atcute/lexicons": "^1.2.9",
    "@atcute/xrpc-server": "^0.1.11",
    "@atcute/xrpc-server-node": "^0.1.1"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/eslint-config": "3.0.0",
    "@adonisjs/lucid": "^22.4.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@arethetypeswrong/cli": "^0.18.2",
    "@atcute/cbor": "^2.3.2",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@japa/assert": "^4.2.0",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.3.5",
    "better-sqlite3": "^12.9.0",
    "c8": "^11.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^10.0.3",
    "luxon": "^3.7.2",
    "np": "^11.0.2",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.0",
    "typescript": "^5.4.5",
    "yalc": "1.0.0-pre.53"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/lucid": "^22.4.0",
    "@atcute/cbor": "^2.3.2",
    "luxon": "^3.7.2"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    },
    "@atcute/cbor": {
      "optional": true
    },
    "@adonisjs/lucid": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./configure.ts",
      "./commands/generate_signing_key.ts",
      "./commands/labeler_debug.ts",
      "./providers/provider.ts",
      "./services/labeler.ts",
      "./src/middleware.ts",
      "./src/types.ts",
      "./src/lucid_label_store.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext",
    "unbundle": true
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
